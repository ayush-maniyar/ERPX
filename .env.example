# Copy this file to .env (or export these as real environment variables) and
# fill in real values. Never commit the filled-in version.
#
# None of these are required to just start the backend locally — every one
# has a dev-safe default in application.properties. They matter once you need
# real email delivery, a non-default JWT secret, or the prod (Postgres) profile.

# --- JWT ---
# Base64-encoded key, at least 32 bytes (256 bits) for HS256.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional, defaults to 86400000 (24h) if unset.
JWT_EXPIRATION_MS=

# --- Gmail SMTP (only needed to actually send bulk emails) ---
# Use a Google App Password, NOT your real account password:
# https://myaccount.google.com/apppasswords
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- Profile selection ---
# 'local' (default) uses an embedded H2 file DB — no setup needed.
# 'prod' uses PostgreSQL — also set POSTGRES_PASSWORD below and have a
# Postgres instance running with an erp_db database.
SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL (only needed when SPRING_PROFILES_ACTIVE=prod) ---
POSTGRES_PASSWORD=
