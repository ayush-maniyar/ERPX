# Copy this file to local.properties (same directory) and point sdk.dir at
# your own Android SDK install. local.properties is machine-specific and is
# gitignored — every developer needs their own copy.
#
# Windows example (note the escaped backslashes/colon):
# sdk.dir=C\:\\Users\\yourname\\AppData\\Local\\Android\\Sdk
#
# macOS/Linux example:
# sdk.dir=/Users/yourname/Library/Android/sdk
