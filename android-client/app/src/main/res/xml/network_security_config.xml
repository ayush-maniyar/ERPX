<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is permitted so the app can reach a backend at any LAN
         address the user enters at runtime. Listing specific hosts here would
         mean rebuilding the APK every time the server's DHCP lease changes.
         Point the server URL at an https:// host for anything beyond local dev. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
